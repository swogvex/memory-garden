{
  "name": "memory-garden",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
