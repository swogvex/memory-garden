{
  "name": "memory-garden",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "node scripts/guard-deploy.mjs && astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply memory-garden-db --local",
    "dev:reset": "node scripts/dev-reset.mjs",
    "gen-secrets": "node scripts/gen-secrets.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:audit": "node scripts/run-audit.mjs",
    "audit:summary": "node scripts/audit-summary.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate": "npm run format:check && npm run lint && npm run check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/svelte": "^9.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "astro": "^7.4.2",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "valibot": "^1.5.0",
    "wrangler": "^4.150.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
