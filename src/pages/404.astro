---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, t } from '@/lib/i18n';

// Página 404 propia: sin JavaScript, `noindex` (BaseLayout) y un enlace al inicio.
// En Cloudflare, una ruta que no existe llega al Worker y Astro responde con esta página y estado 404.
const locale = DEFAULT_LOCALE;
---

<BaseLayout title={t(locale, 'notfound.title')} locale={locale}>
  <h1>{t(locale, 'notfound.title')}</h1>
  <p>{t(locale, 'notfound.body')}</p>
  <p>
    <a href="/">{t(locale, 'notfound.back')}</a>
  </p>
</BaseLayout>
